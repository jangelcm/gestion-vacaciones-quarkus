# ============================================================================
# Variables globales de infraestructura
# ============================================================================
POSTGRES_ADMIN_USER=vacaciones_user
POSTGRES_ADMIN_PASSWORD=vacaciones_pass
POSTGRES_MULTIPLE_DATABASES=db_solicitudes,db_aprobaciones,db_auth,db_politicas

MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_pass

KAFKA_BOOTSTRAP=kafka:9092

# ============================================================================
# ms-solicitud
# ============================================================================
MS_SOLICITUD_DB_USER=solicitudes_user
MS_SOLICITUD_DB_PASS=solicitudes_pass
MS_SOLICITUD_DB_NAME=db_solicitudes

# ============================================================================
# ms-aprobaciones
# ============================================================================
MS_APROBACIONES_DB_USER=aprobaciones_user
MS_APROBACIONES_DB_PASS=aprobaciones_pass
MS_APROBACIONES_DB_NAME=db_aprobaciones

# ============================================================================
# mcsv-auth (aun no se usa en flujo final, pero queda preparado)
# ============================================================================
MS_AUTH_DB_USER=admin
MS_AUTH_DB_PASS=admin
MS_AUTH_DB_NAME=db_auth

# ============================================================================
# ms-politicas
# ============================================================================
MS_POLITICAS_DB_USER=politicas_user
MS_POLITICAS_DB_PASS=politicas_pass
MS_POLITICAS_DB_NAME=db_politicas

# ============================================================================
# ms-notificaciones — SMTP real para envio de correo
# NO pongas credenciales reales aqui (este archivo se commitea).
# Copia este archivo a ".env" (ya esta en .gitignore) y pon ahi tus valores.
# Para Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=tu correo,
# MAIL_PASSWORD=una "contraseña de aplicacion" (requiere verificacion en 2 pasos
# activada en tu cuenta de Google) - https://myaccount.google.com/apppasswords
# ============================================================================
MAIL_FROM=no-reply@vacaciones.local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
