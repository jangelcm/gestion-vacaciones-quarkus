@baseUrl = http://localhost:8080
@politicaId = 4
@colaboradorId = 1001

### Salud
GET {{baseUrl}}/q/health

### Crear politica de prueba
POST {{baseUrl}}/api/v1/politicas
Content-Type: application/json

{
  "nombre": "Politica temporal QA",
  "tipoVacacion": "ANUAL",
  "diasBaseAnio": 15,
  "antiguedadMinimaMeses": 12,
  "acumulable": true,
  "maxDiasAcumulables": 30,
  "activa": true
}

### Consultar politica por id
GET {{baseUrl}}/api/v1/politicas/{{politicaId}}

###
GET {{baseUrl}}/api/v1/politicas

### Actualizar politica por id
PUT {{baseUrl}}/api/v1/politicas/{{politicaId}}
Content-Type: application/json

{
  "nombre": "Politica temporal QA actualizada",
  "tipoVacacion": "ANUAL",
  "diasBaseAnio": 20,
  "antiguedadMinimaMeses": 12,
  "acumulable": true,
  "maxDiasAcumulables": 35,
  "activa": false
}

### Listar todas las politicas
GET {{baseUrl}}/api/v1/politicas

### Asignar politica al colaborador
POST {{baseUrl}}/api/v1/politicas/{{politicaId}}/colaboradores/{{colaboradorId}}

### Asignar politica a colaborador ya asignado (409)
POST {{baseUrl}}/api/v1/politicas/{{politicaId}}/colaboradores/{{colaboradorId}}

### Listar colaboradores asignados a una politica
GET {{baseUrl}}/api/v1/politicas/{{politicaId}}/colaboradores

### Consultar saldo - colaborador con saldo suficiente (1001)
GET {{baseUrl}}/api/v1/politicas/saldo/1001

### Consultar saldo - colaborador con saldo insuficiente (1002)
GET {{baseUrl}}/api/v1/politicas/saldo/1002

### Consultar saldo - colaborador con regla especial (1003)
GET {{baseUrl}}/api/v1/politicas/saldo/1003

### Consultar saldo - colaborador inexistente (404)
GET {{baseUrl}}/api/v1/politicas/saldo/9999

### Validar solicitud - APROBADA (1001, 5 dias habiles, saldo 10)
POST {{baseUrl}}/api/v1/politicas/validar
Content-Type: application/json

{
  "colaboradorId": 1001,
  "fechaInicio": "2026-08-17",
  "fechaFin": "2026-08-21",
  "tipoVacacion": "ANUAL",
  "antiguedadMeses": 12
}

### Validar solicitud - RECHAZADA por saldo insuficiente (1002)
POST {{baseUrl}}/api/v1/politicas/validar
Content-Type: application/json

{
  "colaboradorId": 1002,
  "fechaInicio": "2026-08-17",
  "fechaFin": "2026-08-21",
  "tipoVacacion": "ANUAL",
  "antiguedadMeses": 12
}

### Validar solicitud - APROBADA con regla especial ANTIGUEDAD>=60 (1003)
# 17-25 ago 2026 = 7 dias habiles; saldo 5 + 3 adicionales = 8
POST {{baseUrl}}/api/v1/politicas/validar
Content-Type: application/json

{
  "colaboradorId": 1003,
  "fechaInicio": "2026-08-17",
  "fechaFin": "2026-08-25",
  "tipoVacacion": "ANUAL",
  "antiguedadMeses": 60
}

### Validar solicitud - RECHAZADA sin cumplir regla especial (1003 con poca antiguedad)
POST {{baseUrl}}/api/v1/politicas/validar
Content-Type: application/json

{
  "colaboradorId": 1003,
  "fechaInicio": "2026-08-17",
  "fechaFin": "2026-08-25",
  "tipoVacacion": "ANUAL",
  "antiguedadMeses": 12
}

### Eliminar politica por id
DELETE {{baseUrl}}/api/v1/politicas/{{politicaId}}
